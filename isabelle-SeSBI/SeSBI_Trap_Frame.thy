theory SeSBI_Trap_Frame
  imports Main
begin

section \<open>Trap Table 4 proof inventory\<close>

record TrapFrame =
  trap_mepc :: nat
  trap_mcause :: nat
  trap_mstatus :: nat
  trap_mie :: nat
  trap_mideleg :: nat
  trap_medeleg :: nat
  trap_vector_ready :: bool
  trap_delegated :: bool
  trap_last_error :: nat

definition trap_init_model :: "nat \<Rightarrow> TrapFrame \<Rightarrow> TrapFrame" where
  "trap_init_model vector s =
     s\<lparr> trap_mie := 0,
        trap_vector_ready := True,
        trap_last_error := 0 \<rparr>"

definition trap_delegate_model :: "nat \<Rightarrow> nat \<Rightarrow> TrapFrame \<Rightarrow> TrapFrame" where
  "trap_delegate_model ideleg edeleg s =
     s\<lparr> trap_mideleg := ideleg,
        trap_medeleg := edeleg,
        trap_delegated := True \<rparr>"

lemma SeSBI_Trap_Frame_init_mie_00000:
  shows
    "trap_mie (trap_init_model vector s) = 0"
  by (simp add: trap_init_model_def trap_delegate_model_def)

lemma SeSBI_Trap_Frame_init_ready_00001:
  shows
    "trap_vector_ready (trap_init_model vector s) = True"
  by (simp add: trap_init_model_def trap_delegate_model_def)

lemma SeSBI_Trap_Frame_init_mepc_00002:
  shows
