definition napotRegion  :: \<open>(64)Word.word \<Rightarrow> int*int \<close>  where 
     \<open> napotRegion pmpaddr = (
   (let mask1 = ((xor_vec pmpaddr ((add_vec_int pmpaddr (( 1 :: int)::ii)  ::  64 Word.word))  ::  64 Word.word)) in
   (let begin_words = (Word.uint ((and_vec pmpaddr ((not_vec mask1  ::  64 Word.word))  ::  64 Word.word))) in
   (let end_words = (((begin_words + ((Word.uint mask1)))) + (( 1 :: int)::ii)) in
   ((begin_words * (( 4 :: int)::ii)), (end_words * (( 4 :: int)::ii)))))))\<close> 
  for  "pmpaddr"  :: "(64)Word.word "


\<comment> \<open>\<open>val pmpMatchAddr : ii -> ii -> Pmpcfg_ent -> mword ty64 -> mword ty64 -> pmpAddrMatch\<close>\<close>

definition pmpMatchAddr  :: \<open> int \<Rightarrow> int \<Rightarrow> Pmpcfg_ent \<Rightarrow>(64)Word.word \<Rightarrow>(64)Word.word \<Rightarrow> pmpAddrMatch \<close>  where 
     \<open> pmpMatchAddr (addr :: ii) (width :: ii) (ent :: Pmpcfg_ent) (pmpaddr :: 64 bits) (prev_pmpaddr :: 64
  bits) = (
   (case (Pmpcfg_ent_cfg_A   ent) of
     OFF => PMP_NoMatch
   | TOR =>
      if ((((Word.uint prev_pmpaddr)) \<ge> ((Word.uint pmpaddr)))) then PMP_NoMatch
      else (pmpRangeMatch ((pmpaddrAddr prev_pmpaddr)) ((pmpaddrAddr pmpaddr)) addr width)
   | NA4 =>
      (let begin1 = (pmpaddrAddr pmpaddr) in
      (pmpRangeMatch begin1 ((begin1 + (( 4 :: int)::ii))) addr width))
   | NAPOT =>
      (let (begin1, end1) = (napotRegion pmpaddr) in
      (pmpRangeMatch begin1 end1 addr width))
   ))\<close> 
  for  "addr"  :: " int " 
  and  "width"  :: " int " 
  and  "ent"  :: " Pmpcfg_ent " 
  and  "pmpaddr"  :: "(64)Word.word " 
  and  "prev_pmpaddr"  :: "(64)Word.word "


\<comment> \<open>\<open>val pmpCheckFromPrev : mword ty64 -> list PmpRawEntry -> ii -> ii -> PmpAccess -> Privilege -> (maybe PmpException)\<close>\<close>

function (sequential,domintros)  pmpCheckFromPrev  :: \<open>(64)Word.word \<Rightarrow>(PmpRawEntry)list \<Rightarrow> int \<Rightarrow> int \<Rightarrow> PmpAccess \<Rightarrow> Privilege \<Rightarrow>(PmpException)option \<close>  where 
     \<open> pmpCheckFromPrev (prev :: 64 bits) (([]) :: PmpRawEntry list) (addr :: ii) (width :: ii) (access ::
  PmpAccess) (priv :: Privilege) = ( (case  priv of   Machine => None | _ => Some ((accessFaultFromAccessType access)) ))\<close> 
  for  "prev"  :: "(64)Word.word " 
  and  "addr"  :: " int " 
  and  "width"  :: " int " 
  and  "access"  :: " PmpAccess " 
  and  "priv"  :: " Privilege "
|\<open> pmpCheckFromPrev (prev :: 64 bits) ((ent # rest) :: PmpRawEntry list) (addr :: ii) (width :: ii) (access ::
  PmpAccess) (priv :: Privilege) = (
      (case  ((pmpMatchAddr addr width(PmpRawEntry_raw_cfg   ent)(PmpRawEntry_raw_addr   ent) prev)) of
        PMP_NoMatch =>
         (pmpCheckFromPrev(PmpRawEntry_raw_addr   ent) rest addr width access priv
           ::  PmpException option)
      | PMP_PartialMatch => Some ((accessFaultFromAccessType access))
      | PMP_Match =>
         if (((((pmpCheckRWX(PmpRawEntry_raw_cfg   ent) access)) \<or> ((case  priv of
                  Machine => if ((pmpLocked(PmpRawEntry_raw_cfg   ent))) then False else True
                | _ => False
                ))))) then
           None
         else Some ((accessFaultFromAccessType access))
      ))\<close> 
  for  "prev"  :: "(64)Word.word " 
  and  "ent"  :: " PmpRawEntry " 
  and  "rest"  :: "(PmpRawEntry)list " 
  and  "addr"  :: " int " 
  and  "width"  :: " int " 
  and  "access"  :: " PmpAccess " 
  and  "priv"  :: " Privilege " 
by pat_completeness auto


