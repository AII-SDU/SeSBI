     \<open> pmpRangeMatch (begin1 :: ii) (end1 :: ii) (addr :: ii) (width :: ii) = (
   if (((((((addr + width)) \<le> begin1)) \<or> ((end1 \<le> addr))))) then PMP_NoMatch
   else if (((((begin1 \<le> addr)) \<and> ((((addr + width)) \<le> end1))))) then PMP_Match
   else PMP_PartialMatch )\<close> 
  for  "begin1"  :: " int " 
  and  "end1"  :: " int " 
  and  "addr"  :: " int " 
  and  "width"  :: " int "


